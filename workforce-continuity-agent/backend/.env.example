# OpenRouter API key (free models via https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GitHub Personal Access Token (needs repo scope)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Target GitHub repository URL (the repo the agent will push code to)
GITHUB_REPO_URL=https://github.com/nik-nam-is-nani/example.git